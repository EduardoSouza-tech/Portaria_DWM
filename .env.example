# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sass?schema=public"
# Segredo para assinar a sessão (gere com: openssl rand -hex 32)
AUTH_SECRET="troque-por-um-segredo-longo"
# Usuário administrador criado no primeiro start (somente se não houver usuários)
ADMIN_EMAIL="admin@sass.local"
ADMIN_PASSWORD="troque-esta-senha"
