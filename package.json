{
  "name": "sass",
  "version": "1.0.0",
  "private": true,
  "description": "SASS — Gestão de investimentos imobiliários: obras por administração (Empresa 1) e leilão de imóveis (Empresa 2).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && node prisma/seed.mjs && next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.17",
    "next": "15.5.29",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
